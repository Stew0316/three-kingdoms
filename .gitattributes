# Normalize EOL for all files that Git considers text files.
* text=auto eol=lf
# 下载归档属于二进制，不做换行归一化，也不尝试文本 diff。
*.zip -text -diff
*.7z -text -diff
*.rar -text -diff
Source/_downloads/** filter=lfs diff=lfs merge=lfs -text
# .gdignore 只是 Godot 的目录标记，保持普通文本，不进 LFS。
Source/_downloads/.gdignore !filter !diff !merge
